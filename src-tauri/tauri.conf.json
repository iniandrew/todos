{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todos",
  "version": "0.1.0",
  "identifier": "com.iniandrew.todos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todos",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A beautiful cross-platform to-do app",
    "longDescription": "Todos is a fast, beautiful, cross-platform to-do app inspired by Microsoft To Do, built with Rust and Tauri.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
